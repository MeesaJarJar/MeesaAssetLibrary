# Copy this file to admin/.env.local and edit the values.
# admin/.env.local is gitignored. Do not commit real secrets.

# Optional. When set, every /api/* request needs Authorization: Bearer <token>.
# The console asks for it once and keeps it in this tab's sessionStorage only.
ADMIN_TOKEN=change-me

# Repository root. Defaults to the parent of admin/.
MEESA_ROOT=D:\repos\MeesaAssetLibrary

# Local models and services.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
COMFYUI_URL=http://127.0.0.1:8188

# Optional. Default is 4310. Set 0 to pick a free port (useful in tests).
# ADMIN_PORT=4310

# Optional test switch. 1 uses a deterministic mock engine with no network
# access, no asset writes, and no publishing. Leave unset for real work.
# MEESA_MOCK=1

# There is deliberately no GitHub token here. publishPack uses the local git
# credential or gh login to commit and push.
